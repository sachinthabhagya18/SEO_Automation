# Generate .env with scripts/setup.ps1; never commit generated values.
DJANGO_SECRET_KEY=GENERATE_RANDOM_AT_LEAST_32_CHARACTERS
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
POSTGRES_DB=seo
POSTGRES_USER=seo
POSTGRES_PASSWORD=GENERATE_RANDOM
POSTGRES_HOST=db
N8N_DB_PASSWORD=GENERATE_RANDOM
N8N_ENCRYPTION_KEY=GENERATE_RANDOM
REDIS_URL=redis://redis:6379/0
# Optional bounded Gemini profile suggestions. Disabled until explicitly enabled.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
RESEARCH_AI_ENABLED=false
# Explicit allowlist for protected owned staging HTML reads. Never disables TLS checks.
PROTECTED_STAGING_HOSTS=
# Optional operator-pinned public origin for the owned Denim Yard staging site.
# Requires the matching public certificate obtained through verified SSH.
DENIM_STAGING_ORIGIN_IP=
# Separate Fernet key(s); setup generates the first key. Keep old keys during rotation.
CONNECTION_ENCRYPTION_KEYS=

# Explicit test-only publication allowlist; production is always blocked.
STAGING_PUBLICATION_HOSTS=

# Google Search Console OAuth (separate from Gemini); fill privately.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/integrations/google/callback/
