{
  "name": "SEO ? Scheduled public audit dispatcher",
  "active": false,
  "nodes": [
    {
      "id": "schedule",
      "name": "Every minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "manual",
      "name": "Manual test",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        180
      ],
      "parameters": {}
    },
    {
      "id": "dispatch-due-audit",
      "name": "Dispatch due audit",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "url": "http://web:8000/api/v1/automation/dispatch-due/",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}"
      }
    },
    {
      "id": "authenticated-webhook",
      "name": "Authenticated audit request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        -180
      ],
      "webhookId": "company-seo-due-audit",
      "parameters": {
        "httpMethod": "POST",
        "path": "company-seo-due-audit",
        "authentication": "headerAuth",
        "responseMode": "lastNode",
        "options": {}
      }
    }
  ],
  "connections": {
    "Manual test": {
      "main": [
        [
          {
            "node": "Dispatch due audit",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Authenticated audit request": {
      "main": [
        [
          {
            "node": "Dispatch due audit",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Every minute": {
      "main": [
        [
          {
            "node": "Dispatch due audit",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Colombo",
    "saveManualExecutions": true,
    "executionTimeout": 180
  }
}